{
  "name": "vue-use-calendar",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Calendar & dates composables for Vue 3.",
  "keywords": [
    "vue",
    "calendar",
    "date",
    "ssr"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "build": "tsup lib/index.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run build",
    "lint": "eslint --ext .ts,.js,.vue .",
    "lint:fix": "eslint --ext .ts,.js,.vue --fix .",
    "dev:example": "vite example",
    "build:example": "vite build example",
    "start:example": "vite preview example",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:docs": "vitepress build docs && push-dir --dir=docs/.vitepress/dist --branch=gh-pages --cleanup"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kapcash/vue-use-calendar"
  },
  "author": {
    "name": "Kapcash",
    "url": "https://kapcash.dev"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.0.0",
    "push-dir": "^0.4.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
